{
  "name": "ashikur-colors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive color atlas and card designer by Ashikur Rahman.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "color-description": "^0.23.0",
    "culori": "^4.0.2",
    "dittotones": "^0.13.0",
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "author": "Ashikur Rahman (https://github.com/ashikurweb)",
  "homepage": "https://github.com/ashikurweb"
}
